@model Demo_Product.EntityLayer.Concrete.Job
@{
    ViewData["Title"] = "EditJob";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<h1>Edit Job</h1>

<h1>Edit Customer</h1>

<form asp-controller="Job" asp-action="EditJob" method="post">

    <div>
        <label> Job Id</label>
