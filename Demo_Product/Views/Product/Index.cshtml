@using Demo_Product.EntityLayer.Concrete

@model List<Product>

@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<h1>Product List</h1>
<table class="table table-bordered">

    <tr>
        <th>#</th>
        <th>Product Name</th>
        <th>Product Price</th>
        <th>Product Stock</th>
        <th> Options</th>
    </tr>

    @foreach(var item in Model)
    {
        
        <tr>
            <td>@item.ProductId</td>
            <td>@item.ProductName</td>
            <td>@item.ProductPrice</td>
            <td>@item.ProductStock</td>
           <td>
                <a href="/Product/DeleteProduct/@item.ProductId" class="btn btn-danger mt-3 btn-sm">Delete</a>

                <a href="/Product/EditProduct/@item.ProductId" class="btn btn-success mt-3 btn-sm">Update</a>

           </td>
        </tr>

    }



</table>